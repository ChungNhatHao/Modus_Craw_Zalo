# Tên nhóm có thể đặt ở đây hoặc truyền bằng --group.
ZALO_GROUP_NAME=

# persistent: Playwright mở một Chrome riêng và giữ phiên đăng nhập.
# cdp: kết nối vào Chrome/Edge đã khởi động với --remote-debugging-port.
BROWSER_MODE=persistent
CDP_URL=http://127.0.0.1:9222
BROWSER_PROFILE_DIR=.browser-profile
BROWSER_CHANNEL=chrome
SLOW_MO_MS=80

# Không ghi API key trực tiếp vào mã nguồn.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=25

# Mặc định theo múi giờ Việt Nam.
APP_TIMEZONE=Asia/Ho_Chi_Minh
OUTPUT_DIR=output
SELECTORS_FILE=config/selectors.json
MAX_SCROLLS=300
SCROLL_PAUSE_MS=650

# Chỉ bật sau khi chủ tài khoản đồng ý rằng Zalo có thể đồng bộ lịch sử rộng hơn
# ngày đang crawl.
ALLOW_ZALO_HISTORY_SYNC=false

# Output Google Drive: Sheet DD-MM-YYYY và folder DD-MM-YYYY_image được đặt trong
# folder này. Hỗ trợ OAuth Web Client với Authorized redirect URI chính xác là
# http://127.0.0.1:8766/ hoặc OAuth Desktop Client. Trình duyệt sẽ hỏi quyền ở lần
# chạy đầu và token được lưu cục bộ trong file đã gitignore.
GOOGLE_DRIVE_UPLOAD_ENABLED=true
GOOGLE_DRIVE_PARENT_FOLDER_ID=16kKkK80VwV92uWwxaBklivhHhYArrY2G
GOOGLE_OAUTH_CLIENT_SECRET_FILE=/duong-dan-tuyet-doi/client-secret.json
GOOGLE_OAUTH_TOKEN_FILE=.google-drive-token.json
GOOGLE_OAUTH_REDIRECT_PORT=8766

# Hoặc dùng ADC/service account. Service account cần quyền Editor và nên dùng với
# Shared Drive để tránh giới hạn quyền sở hữu/dung lượng trên My Drive.
# GOOGLE_APPLICATION_CREDENTIALS=/duong-dan-tuyet-doi/google-service-account.json
