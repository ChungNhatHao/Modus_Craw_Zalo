# Tên nhóm có thể đặt ở đây hoặc truyền bằng --group.
ZALO_GROUP_NAME=

# persistent: Playwright mở một Chrome riêng và giữ phiên đăng nhập.
# cdp: kết nối vào Chrome/Edge đã khởi động với --remote-debugging-port.
BROWSER_MODE=persistent
CDP_URL=http://127.0.0.1:9222
BROWSER_PROFILE_DIR=.browser-profile
BROWSER_CHANNEL=chrome
SLOW_MO_MS=80

# Không ghi API key trực tiếp vào mã nguồn.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BATCH_SIZE=25

# Mặc định theo múi giờ Việt Nam.
APP_TIMEZONE=Asia/Ho_Chi_Minh
OUTPUT_DIR=output
SELECTORS_FILE=config/selectors.json
MAX_SCROLLS=300
SCROLL_PAUSE_MS=650

# Chỉ bật sau khi chủ tài khoản đồng ý rằng Zalo có thể đồng bộ lịch sử rộng hơn
# ngày đang crawl.
ALLOW_ZALO_HISTORY_SYNC=false
