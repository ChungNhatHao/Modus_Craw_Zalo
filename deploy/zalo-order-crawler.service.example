[Unit]
Description=Zalo Order Crawler web UI with Xvfb and noVNC
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zalo-crawler
Group=zalo-crawler
WorkingDirectory=/opt/Modus_Craw_Zalo
Environment=PYTHONUNBUFFERED=1
Environment=ZALO_PROJECT_DIR=/opt/Modus_Craw_Zalo
EnvironmentFile=-/etc/zalo-order-crawler.env
ExecStart=/opt/Modus_Craw_Zalo/scripts/run-server-ui.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
